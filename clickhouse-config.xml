<?xml version="1.0"?>
<!--
  ClickHouse configuration for Luminate AI development environment.
  Increased memory for Langfuse trace ingestion.
-->
<clickhouse>
    <!-- Server-wide memory limit (6GB max for 8GB Docker limit) -->
    <max_server_memory_usage>6442450944</max_server_memory_usage>
    
    <!-- Ratio of RAM to use (80%) -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    
    <!-- Increase cache sizes for better performance -->
    <mark_cache_size>536870912</mark_cache_size>
    <uncompressed_cache_size>268435456</uncompressed_cache_size>
    
    <!-- Background workers - must be large enough for mutations -->
    <!-- number_of_free_entries_in_pool_to_execute_mutation defaults to 20 -->
    <!-- So background_pool_size * concurrency_ratio must be >= 20 -->
    <background_pool_size>16</background_pool_size>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
</clickhouse>
